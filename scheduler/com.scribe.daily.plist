<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job: runs the daily arXiv crawl + Claude review once a day.

  Install:
    cp scheduler/com.scribe.daily.plist ~/Library/LaunchAgents/
    # then edit the copied file: replace __PROJECT_DIR__ with the absolute
    # path to this project (e.g. /Volumes/Work/OpenSource/scribe)
    launchctl load ~/Library/LaunchAgents/com.scribe.daily.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.scribe.daily.plist
    rm ~/Library/LaunchAgents/com.scribe.daily.plist

  Run once immediately (for testing, without waiting for the scheduled time):
    launchctl start com.scribe.daily
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scribe.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scheduler/run_daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
